# Copy to .env and adjust.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string

# Real MongoDB (default). Local mongod or an Atlas SRV string.
MONGODB_URI=mongodb://127.0.0.1:27017/character-designer

# Set to 1 to run without MongoDB using an in-memory store (development only).
DEV_MEMORY_DB=0

# Set to 1 to insert demo designers and characters on an empty database.
SEED=0
